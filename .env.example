APP_NAME="FXSignalPro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database - MySQL for production
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gold_digger
DB_USERNAME=root
DB_PASSWORD=

# Public sign-up. Off by default - see config/auth.php.
REGISTRATION_ENABLED=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ===========================================
# Gold Digger - Trading Bot Configuration
# ===========================================

# Trading Defaults
DEFAULT_SYMBOL=XAUUSD
DEFAULT_TIMEFRAME_ENTRY=M15
DEFAULT_TIMEFRAME_TREND=H1

# ===========================================
# Alerts - see docs/MONITORING.md
# ===========================================
# Off unless both are set. Incidents are still recorded and shown on /logs either way.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Move strategy evaluation off the executor's request and onto a queue.
# Requires a worker: php artisan queue:work --queue=strategy
# Without one the bot stores bars and stops trading - see docs/SIGNAL_GENERATION.md.
QUEUE_STRATEGY_EVALUATION=false

# The bar an entry has to clear, for the whole deployment. Each is overridable per account
# in bot_settings, and min_confluence again per provider in telegram_channels.
# See docs/SIGNAL_GENERATION.md - "The floors an entry has to clear".
MIN_CONFLUENCE=3.0
MIN_DIRECTIONAL=1.5

# Reward against risk, measured to the take-profit the order actually carries.
# 0 means no floor, and 0 is the default: turning one on starts refusing trades that
# currently execute, so it is a decision to make rather than one to inherit.
MIN_REWARD_RATIO=0

# OpenRouter powers the analysis cards, the copier's reviewer and the strategy proposer.
# All are off unless the key is present; nothing else on the dashboard depends on them.
# See docs/AI_INTEGRATION.md for what each model is asked to decide.
OPENROUTER_API_KEY=

# The default for everything that is not listed separately below.
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Reading a signal off a screenshot. Transcription, not judgement.
OPENROUTER_VISION_MODEL=anthropic/claude-sonnet-5

# Proposing strategy parameters. WalkForward still decides whether they are any good.
OPENROUTER_PROPOSER_MODEL=anthropic/claude-sonnet-5

# Judging somebody else's signal - the copier's reviewer and the two interpreters.
# The only callers that read a stranger's words and then move a real position.
# anthropic/claude-opus-5 is the upgrade path here, and it costs more per call.
OPENROUTER_REVIEWER_MODEL=anthropic/claude-sonnet-5

# Rarely changed. Defaults shown; omit them entirely and these are what you get.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=90

# How long an analysis is kept. Cache keys are scoped to the newest bar, so this is a
# backstop rather than the thing that expires an answer.
AI_CACHE_MINUTES=15

# How many model calls one tenant may make in a day. Every call site runs on the single
# key above, so without this a customer's analysis is an unbounded bill for whoever runs
# the deployment. A tenant can be given their own ceiling in bot_settings.ai_daily_call_limit.
# See docs/AI_INTEGRATION.md — "Who pays, and how much they may spend".
AI_DAILY_CALL_LIMIT=200

# Telegram MTProto — one application shared by every tenant, from https://my.telegram.org.
# Without these, hosted sign-in cannot run and accounts fall back to a self-hosted collector.
TELEGRAM_APP_ID=
TELEGRAM_APP_HASH=

# Infrastructure credential for the hosted session worker. It reaches every tenant's
# session, so treat it like the database password: long, random, never in the dashboard.
TELEGRAM_WORKER_TOKEN=
TELEGRAM_HOSTED_BY_DEFAULT=true
