APP_NAME="FXSignalPro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database - MySQL for production
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gold_digger
DB_USERNAME=root
DB_PASSWORD=

# Public sign-up. Off by default - see config/auth.php.
REGISTRATION_ENABLED=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ===========================================
# Gold Digger - Trading Bot Configuration
# ===========================================

# Trading Defaults
DEFAULT_SYMBOL=XAUUSD
DEFAULT_TIMEFRAME_ENTRY=M15
DEFAULT_TIMEFRAME_TREND=H1

# ===========================================
# Alerts - see docs/MONITORING.md
# ===========================================
# Off unless both are set. Incidents are still recorded and shown on /logs either way.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Move strategy evaluation off the executor's request and onto a queue.
# Requires a worker: php artisan queue:work --queue=strategy
# Without one the bot stores bars and stops trading - see docs/SIGNAL_GENERATION.md.
QUEUE_STRATEGY_EVALUATION=false

# OpenRouter powers the written analysis card and the strategy proposer.
# Both are off unless the key is present; nothing else on the dashboard depends on them.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_PROPOSER_MODEL=anthropic/claude-sonnet-4.5

# Telegram MTProto — one application shared by every tenant, from https://my.telegram.org.
# Without these, hosted sign-in cannot run and accounts fall back to a self-hosted collector.
TELEGRAM_APP_ID=
TELEGRAM_APP_HASH=

# Infrastructure credential for the hosted session worker. It reaches every tenant's
# session, so treat it like the database password: long, random, never in the dashboard.
TELEGRAM_WORKER_TOKEN=
TELEGRAM_HOSTED_BY_DEFAULT=true
