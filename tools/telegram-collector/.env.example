# Telegram API credentials for a *user account*, from https://my.telegram.org -> API
# development tools. These identify the client, not the account; the account is added by
# `python collector.py login`.
TG_API_ID=
TG_API_HASH=

# The dashboard, and a token issued from its Terminal Setup page. Revoking that token
# stops this collector without touching the Telegram account.
GD_BASE_URL=https://fx.example.com
GD_TOKEN=

# Where the account session and the per-channel checkpoints live. The .session file is a
# full account credential - it can read every chat and post as you. Keep it 600 and off
# shared storage.
GD_SESSION_FILE=./gold-digger
GD_STATE_FILE=./state.json

# How often to re-read the dashboard's watch list, so enabling a channel takes effect
# without a restart.
GD_REFRESH_SECONDS=60

# How far back to look on a first run or when a channel is newly enabled.
GD_BACKFILL_LIMIT=20
